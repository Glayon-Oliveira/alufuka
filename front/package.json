{
  "name": "alufuka",
  "version": "1.0.0",
  "description": "Java documentation explorer",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "package": "npm run build && electron-forge package",
    "build": "npm run build-vite && npm run build-java",
    "build-vite": "vite build",
    "build-java": "(cd ../java-service && mvn install) && cp ../java-service/target/alufuka.jar java-service",
    "build-java-image": "npm run build-java && rm -rf java-service/alufuka-image/ && jpackage --input java-service --name alufuka --main-jar alufuka.jar --type app-image --dest java-service/alufuka-image",
    "make": "npm run build-vite && npm run build-java-image && electron-forge make"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "extraResource": [
          "dist",
          "java-service/alufuka-image/alufuka"
        ]
      },
      "makers": [
        { "name": "@electron-forge/maker-zip" },
        { "name": "@electron-forge/maker-deb" },
        { "name": "@electron-forge/maker-rpm" },
        { "name": "@electron-forge/maker-squirrel" }
      ]
    }
  }
}
